<!DOCTYPE html>
<html lang="en">
<head>
  {% assign profile = site.data.profile %}
  <meta charset="utf-8" />
  <title>{% if page.title %}{{ page.title }} | {{ profile.name | default: site.title }}{% else %}{{ profile.name | default: site.title }}{% endif %}</title>
  <meta name="author" content="{{ profile.name | default: site.title }}" />
  <meta name="description" content="{{ page.description | default: profile.headline | default: site.description }}" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta id="theme-color" name="theme-color" content="#f4efe6" />
  <script>
    (function () {
      var theme = "light";
      try {
        var savedTheme = localStorage.getItem("site-theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          theme = savedTheme;
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          theme = "dark";
        }
      } catch (error) {
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          theme = "dark";
        }
      }
      document.documentElement.dataset.theme = theme;
      document.querySelector("#theme-color").content = theme === "dark" ? "#171613" : "#f4efe6";
    })();
  </script>
  <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/assets/icons/favicon.ico" />
  <link href="/assets/css/site.css?v={{ site.asset_version }}" rel="stylesheet" />
</head>
<body class="site-body nav-{{ page.nav_key | default: 'none' }}">
  {% assign nav_key = page.nav_key | default: '' %}
  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-brand" href="/" aria-label="{{ profile.name }} home">
        <span class="brand-mark">{{ profile.initials }}</span>
        <span class="brand-copy">
          <span class="brand-name">{{ profile.name }}</span>
          <span class="brand-field">{{ profile.field }}</span>
        </span>
      </a>

      <div class="site-controls">
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a class="nav-link{% if nav_key == 'research' %} is-active{% endif %}" href="/">Research</a>
          <a class="nav-link{% if nav_key == 'experience' %} is-active{% endif %}" href="/experience/">Experience</a>
          <a class="nav-link{% if nav_key == 'publications' %} is-active{% endif %}" href="/publications/">Publications</a>
          <a class="nav-link{% if nav_key == 'code' %} is-active{% endif %}" href="/code/">Code</a>
          <a class="nav-link{% if nav_key == 'education' %} is-active{% endif %}" href="/education/">Education</a>
          <a class="nav-link" href="/data/cv.pdf">CV</a>
          <a class="nav-link{% if nav_key == 'contact' %} is-active{% endif %}" href="/contact/">Contact</a>
        </nav>

        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
          <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M15.8 13.1A6.9 6.9 0 0 1 6.9 4.2 6.9 6.9 0 1 0 15.8 13.1Z" fill="currentColor" />
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7" />
            <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M16 4l-1.4 1.4M5.4 14.6 4 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" />
          </svg>
          <span class="theme-toggle__text" data-theme-label>Dark</span>
        </button>

        <details class="mobile-nav">
          <summary aria-label="Open navigation">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <nav aria-label="Mobile navigation">
            <a href="/">Research</a>
            <a href="/experience/">Experience</a>
            <a href="/publications/">Publications</a>
            <a href="/code/">Code</a>
            <a href="/education/">Education</a>
            <a href="/data/cv.pdf">CV</a>
            <a href="/contact/">Contact</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  {{ content }}

  <footer class="site-footer">
    <div class="page-shell site-footer__inner">
      <span>{{ profile.name }}</span>
      <span>{{ profile.field }}</span>
    </div>
  </footer>
  <script src="/assets/js/site.js?v={{ site.asset_version }}"></script>
</body>
</html>
